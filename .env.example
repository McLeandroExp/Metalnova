# MetalNova Smart Factory BI — plantilla de variables de entorno
# Copiar a .env y ajustar. NO commitear .env (está en .gitignore).

# --- Credenciales de PostgreSQL (sintéticas, solo entorno local) ---
POSTGRES_USER=metalinova
POSTGRES_PASSWORD=cambiar_esta_clave_local
POSTGRES_DB=metalinova

# --- Puerto publicado. Se enlaza SOLO a 127.0.0.1 (loopback) ---
POSTGRES_HOST_PORT=5432

# --- Cliente de base de datos: pgAdmin ---
# Credenciales de acceso a la interfaz web de pgAdmin (no son las de PostgreSQL).
PGADMIN_DEFAULT_EMAIL=admin@metalinova.com
PGADMIN_DEFAULT_PASSWORD=cambiar_esta_clave_pgadmin
PGADMIN_PORT=5050

# --- Zona horaria de los contenedores (los timestamps se guardan en UTC) ---
TZ=UTC

# --- Ingesta continua simulada (incremento 004) ---
# Se pueden sobreescribir por CLI (--interval, --seed, --intensity).
SIM_INTERVAL_SECONDS=60
SIM_SEED=42
SIM_INTENSITY=1.0
