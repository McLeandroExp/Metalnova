model Model
	culture: es-ES
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: es-EC
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["v_dim_maquina", "v_dim_producto", "dim_tiempo", "dim_turno", "dim_causa", "v_loss_tree", "v_kpi_parada", "v_kpi_mantenimiento_maquina_turno", "v_kpi_mantenimiento", "v_kpi_calidad_maquina_dia", "v_alerta_maquina_critica", "v_kpi_parametros"]

annotation PBI_ProTooling = ["DevMode"]

ref table v_dim_maquina
ref table v_dim_producto
ref table dim_tiempo
ref table dim_turno
ref table dim_causa
ref table v_loss_tree
ref table v_kpi_parada
ref table v_kpi_mantenimiento_maquina_turno
ref table v_kpi_mantenimiento
ref table v_kpi_calidad_maquina_dia
ref table v_alerta_maquina_critica
ref table v_kpi_parametros

ref cultureInfo es-ES
