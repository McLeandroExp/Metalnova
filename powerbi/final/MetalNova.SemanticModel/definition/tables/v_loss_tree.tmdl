table v_loss_tree
	lineageTag: 6354539e-0412-58cd-a32e-ce5395f67c30

	measure 'Disponibilidad KPI' =
			DIVIDE ( SUM ( v_loss_tree[tiempo_operativo_min] ), SUM ( v_loss_tree[tiempo_planificado_min] ) )
		formatString: 0.00%
		displayFolder: 01 OEE
		lineageTag: d989018d-bd2a-56f8-987f-9d02920e20d9

	measure 'Rendimiento KPI' =
			DIVIDE ( SUM ( v_loss_tree[minutos_ideales] ), SUM ( v_loss_tree[tiempo_operativo_min] ) )
		formatString: 0.00%
		displayFolder: 01 OEE
		lineageTag: 4e055a5f-a2a7-59d5-a130-b8f11b968af9

	measure 'Calidad KPI' =
			DIVIDE ( SUM ( v_loss_tree[good_count] ), SUM ( v_loss_tree[total_count] ) )
		formatString: 0.00%
		displayFolder: 01 OEE
		lineageTag: e06c4c0e-b27f-53d8-9140-a82c1f24e6c5

	measure 'OEE KPI' =
			[Disponibilidad KPI] * [Rendimiento KPI] * [Calidad KPI]
		formatString: 0.00%
		displayFolder: 01 OEE
		lineageTag: 2de61599-1284-5815-852c-65ca7c4281b4

	measure 'OEE Meta' =
			0.85
		formatString: 0.00%
		displayFolder: 01 OEE
		lineageTag: 5397048d-efdf-554b-b0fb-106a69b3b8a2

	measure 'Brecha Meta (pp)' =
			( [OEE KPI] - [OEE Meta] ) * 100
		formatString: 0.00
		displayFolder: 01 OEE
		lineageTag: 2e575b82-f44e-5a1d-899e-74d8afeb2803

	measure 'OEE Último Mes' =
			VAR UltimoMes = MAX ( v_loss_tree[anio_mes] )
			RETURN CALCULATE ( [OEE KPI], v_loss_tree[anio_mes] = UltimoMes )
		formatString: 0.00%
		displayFolder: 01 OEE
		lineageTag: 6396f1a0-1d65-5221-a03e-519a34118b42

	measure 'Cumple Meta OEE' =
			IF ( [OEE KPI] >= [OEE Meta], "Sí", "No" )
		displayFolder: 01 OEE
		lineageTag: 7ee37b9e-3e9c-57db-836f-93e6340e0e54

	measure 'Pérdida Disponibilidad (min)' =
			SUM ( v_loss_tree[minutos_perdidos_disponibilidad] )
		formatString: #,##0
		displayFolder: 02 Pérdidas
		lineageTag: 2792d56b-e2e2-5cc3-a663-445af89ca03a

	measure 'Pérdida Rendimiento (min)' =
			SUM ( v_loss_tree[minutos_perdidos_rendimiento] )
		formatString: #,##0
		displayFolder: 02 Pérdidas
		lineageTag: e93b348a-160c-51b9-a6d3-4963ecdafc9d

	measure 'Pérdida Calidad (min)' =
			SUM ( v_loss_tree[minutos_perdidos_calidad] )
		formatString: #,##0
		displayFolder: 02 Pérdidas
		lineageTag: baba5c9f-6618-5ed4-96d7-382761423925

	measure 'Pérdida Total (min)' =
			SUM ( v_loss_tree[minutos_perdidos_total] )
		formatString: #,##0
		displayFolder: 02 Pérdidas
		lineageTag: a53b7521-b9f3-5860-878d-ba95bdaa6f45

	measure 'Participación Pérdida Disponibilidad' =
			DIVIDE ( SUM ( v_loss_tree[minutos_perdidos_disponibilidad] ), SUM ( v_loss_tree[minutos_perdidos_total] ) )
		formatString: 0.00%
		displayFolder: 02 Pérdidas
		lineageTag: 314f6ca1-149c-578b-b032-566c3146234c

	measure 'Participación Pérdida Rendimiento' =
			DIVIDE ( SUM ( v_loss_tree[minutos_perdidos_rendimiento] ), SUM ( v_loss_tree[minutos_perdidos_total] ) )
		formatString: 0.00%
		displayFolder: 02 Pérdidas
		lineageTag: f6436bd4-aa9d-58fe-943c-cbae24e994e5

	measure 'Participación Pérdida Calidad' =
			DIVIDE ( SUM ( v_loss_tree[minutos_perdidos_calidad] ), SUM ( v_loss_tree[minutos_perdidos_total] ) )
		formatString: 0.00%
		displayFolder: 02 Pérdidas
		lineageTag: 9303143a-c929-5ec9-ad4e-4ce17d87b951

	measure 'Scrap Rate' =
			DIVIDE ( SUM ( v_loss_tree[scrap_count] ), SUM ( v_loss_tree[total_count] ) )
		formatString: 0.00%
		displayFolder: 03 Calidad y energía
		lineageTag: 5e51723f-0454-5620-95fc-4370e40f1fe6

	measure 'Unidades Buenas' =
			SUM ( v_loss_tree[good_count] )
		formatString: #,##0
		displayFolder: 04 Producción
		lineageTag: 3629b92a-be39-57df-9ba2-54bcec23d7af

	measure 'Unidades Totales' =
			SUM ( v_loss_tree[total_count] )
		formatString: #,##0
		displayFolder: 04 Producción
		lineageTag: 71f6d8aa-4a86-5add-9d06-9d466f00c747

