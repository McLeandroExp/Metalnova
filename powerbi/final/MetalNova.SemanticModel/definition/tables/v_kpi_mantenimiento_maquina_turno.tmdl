table v_kpi_mantenimiento_maquina_turno
	lineageTag: 2fb9b69f-9ef1-55f7-83a6-e1991458f6ee

	measure 'MTBF (h)' =
			DIVIDE ( SUM ( v_kpi_mantenimiento_maquina_turno[tiempo_operativo_min] ), SUM ( v_kpi_mantenimiento_maquina_turno[fallas] ) * 60 )
		formatString: #,##0.00
		displayFolder: 05 Mantenimiento
		lineageTag: f9fda6d0-f2be-578f-8e64-4c1fc23e9b02

	measure 'MTTR (min)' =
			DIVIDE ( SUM ( v_kpi_mantenimiento_maquina_turno[minutos_reparacion] ), SUM ( v_kpi_mantenimiento_maquina_turno[reparaciones] ) )
		formatString: #,##0.00
		displayFolder: 05 Mantenimiento
		lineageTag: 66c8a0b8-44bc-5a77-abea-f4dcbaede0e8

	measure 'MTTR (h)' =
			DIVIDE ( [MTTR (min)], 60 )
		formatString: #,##0.00
		displayFolder: 05 Mantenimiento
		lineageTag: b8ebf527-74ac-53af-89ae-b1bbf7beba8d

	measure 'Fallas (conteo)' =
			SUM ( v_kpi_mantenimiento_maquina_turno[fallas] )
		formatString: #,##0
		displayFolder: 05 Mantenimiento
		lineageTag: e6365a34-dcab-5cd7-8150-77359ec30da2

	measure 'Microparadas (conteo)' =
			SUM ( v_kpi_mantenimiento_maquina_turno[microparadas] )
		formatString: #,##0
		displayFolder: 05 Mantenimiento
		lineageTag: 5406a463-7bc9-5db2-89d3-121869ca56d1

	measure 'Duración Media Falla (min)' =
			DIVIDE ( SUM ( v_kpi_mantenimiento_maquina_turno[minutos_fallas] ), SUM ( v_kpi_mantenimiento_maquina_turno[fallas] ) )
		formatString: #,##0.00
		displayFolder: 05 Mantenimiento
		lineageTag: 97c35af0-d50a-54c8-baf1-8f43fbb5f518

	measure 'Fallas por 100 h' =
			DIVIDE ( SUM ( v_kpi_mantenimiento_maquina_turno[fallas] ) * 60, SUM ( v_kpi_mantenimiento_maquina_turno[tiempo_operativo_min] ) ) * 100
		formatString: #,##0.00
		displayFolder: 05 Mantenimiento
		lineageTag: c1648bee-83a1-52b3-a191-ebab5869479f

	measure 'Downtime Mantenimiento (min)' =
			SUM ( v_kpi_mantenimiento_maquina_turno[downtime_no_planificado_min] )
		formatString: #,##0
		displayFolder: 05 Mantenimiento
		lineageTag: 0701bd37-1eb2-51f8-9f1f-6a8c30c87935

	measure 'Downtime Mantenimiento (h)' =
			DIVIDE ( [Downtime Mantenimiento (min)], 60 )
		formatString: #,##0.00
		displayFolder: 05 Mantenimiento
		lineageTag: f4cf5938-3eaf-5750-8aff-52915001f17d

	measure 'Fallas cortas (conteo)' =
			SUM ( v_kpi_mantenimiento_maquina_turno[fallas_cortas] )
		formatString: #,##0
		displayFolder: 05 Mantenimiento
		lineageTag: b33329cf-42f3-588e-93e8-0b7bcbf6e77f

	measure 'MTBF corto (h)' =
			DIVIDE ( SUM ( v_kpi_mantenimiento_maquina_turno[tiempo_operativo_min] ), SUM ( v_kpi_mantenimiento_maquina_turno[fallas_cortas] ) * 60 )
		formatString: #,##0.00
		displayFolder: 05 Mantenimiento
		lineageTag: 2d6bb400-12fb-570e-acd9-6a9e0b091ccc

	measure 'Fallas cortas por 100 h' =
			DIVIDE ( SUM ( v_kpi_mantenimiento_maquina_turno[fallas_cortas] ) * 60, SUM ( v_kpi_mantenimiento_maquina_turno[tiempo_operativo_min] ) ) * 100
