table v_calidad_senal_iot
	lineageTag: 1443b442-4225-536f-998c-8d430fea2c33

	measure 'Cobertura de señal (%)' =
			DIVIDE ( CALCULATE ( COUNTROWS ( v_calidad_senal_iot ), v_calidad_senal_iot[estado_senal] = "ok" ), COUNTROWS ( v_calidad_senal_iot ) )
		formatString: 0.00%
		displayFolder: 09 Calidad de señal
		lineageTag: 5e1473f6-b41a-5cb3-98c9-82cb5f82bd94

	measure 'Días con señal incompleta' =
			CALCULATE ( COUNTROWS ( v_calidad_senal_iot ), v_calidad_senal_iot[estado_senal] <> "ok" )
		formatString: #,##0
		displayFolder: 09 Calidad de señal
		lineageTag: 04cce8d5-8155-5c48-a267-caf084748ba1

	measure 'Hueco máximo (min)' =
			MAX ( v_calidad_senal_iot[max_gap_min] )
		formatString: #,##0.0
		displayFolder: 09 Calidad de señal
		lineageTag: b315e8b8-94ae-5c36-b31a-199c76d4d7f4

