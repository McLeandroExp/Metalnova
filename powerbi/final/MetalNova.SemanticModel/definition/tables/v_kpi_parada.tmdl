table v_kpi_parada
	lineageTag: 130df748-f0cc-52d1-87e4-03f5b4d56bf7

	measure 'Downtime por Causa (min)' =
			CALCULATE ( SUM ( v_kpi_parada[duracion_min] ), v_kpi_parada[es_planificada] = FALSE () )
		formatString: #,##0
		displayFolder: 06 Paradas
		lineageTag: 05121f73-e6f1-5fa6-a913-d197af7b5bda

	measure 'Paradas No Planificadas' =
			CALCULATE ( COUNTROWS ( v_kpi_parada ), v_kpi_parada[es_planificada] = FALSE () )
		formatString: #,##0
		displayFolder: 06 Paradas
		lineageTag: a21daa1d-1fb7-5b40-a7ab-2af143f32981

	measure 'Pareto %' =
			DIVIDE ( [Downtime por Causa (min)], CALCULATE ( [Downtime por Causa (min)], ALLSELECTED ( dim_causa ) ) )
		formatString: 0.00%
		displayFolder: 06 Paradas
		lineageTag: 224ae912-1be6-5e15-95ff-065af7100e1f

	measure 'Máquinas con Paradas' =
			DISTINCTCOUNT ( v_kpi_parada[id_maquina] )
		formatString: #,##0
		displayFolder: 06 Paradas
		lineageTag: a2528db6-19bd-53da-b48e-13ec9f9ad1d1

	measure 'Participación Downtime Causa' =
			DIVIDE ( [Downtime por Causa (min)], CALCULATE ( [Downtime por Causa (min)], ALLSELECTED ( dim_causa ) ) )
		formatString: 0.00%
		displayFolder: 06 Paradas
		lineageTag: 28f1cb35-a47e-51da-b4f9-9e258894d359

