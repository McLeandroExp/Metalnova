table v_kpi_calidad_producto_dia
	lineageTag: 33a48488-4c34-569c-a1c8-964794cd02f6

	measure 'FPY (Producto)' =
			DIVIDE ( SUM ( v_kpi_calidad_producto_dia[unidades_inspeccionadas] ) - SUM ( v_kpi_calidad_producto_dia[unidades_retrabajo] ), SUM ( v_kpi_calidad_producto_dia[unidades_inspeccionadas] ) )
		formatString: 0.00%
		displayFolder: 03 Calidad y energía
		lineageTag: c3e2b899-d620-5c9f-b9b8-85598de08afd

	measure 'Tasa Defectos (Producto)' =
			DIVIDE ( SUM ( v_kpi_calidad_producto_dia[unidades_defectuosas] ), SUM ( v_kpi_calidad_producto_dia[unidades_inspeccionadas] ) )
		formatString: 0.00%
		displayFolder: 03 Calidad y energía
		lineageTag: e68826c1-da5d-5eca-ba66-363c39c03ec8

	measure 'Tasa Retrabajo (Producto)' =
			DIVIDE ( SUM ( v_kpi_calidad_producto_dia[unidades_retrabajo] ), SUM ( v_kpi_calidad_producto_dia[unidades_inspeccionadas] ) )
		formatString: 0.00%
		displayFolder: 03 Calidad y energía
		lineageTag: 6e40feba-6385-5797-80bf-0ddb1317eac5

	measure 'Scrap Rate (Producto)' =
			DIVIDE ( SUM ( v_kpi_calidad_producto_dia[scrap_count] ), SUM ( v_kpi_calidad_producto_dia[total_count] ) )
		formatString: 0.00%
		displayFolder: 03 Calidad y energía
		lineageTag: 52d7c832-41b2-502a-a760-13af16d8559d

	measure 'Energía por Unidad Buena (Producto)' =
			DIVIDE ( SUM ( v_kpi_calidad_producto_dia[energia_kwh] ), SUM ( v_kpi_calidad_producto_dia[good_count] ) )
		formatString: 0.0000
		displayFolder: 03 Calidad y energía
		lineageTag: e02ab98c-c7f1-54f5-9bf9-34f025f4d3d0

