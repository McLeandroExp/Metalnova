table v_kpi_calidad_maquina_dia
	lineageTag: 15920eb8-f482-497d-b66a-5b8b56960943

	measure 'FPY KPI' =
			DIVIDE ( SUM ( v_kpi_calidad_maquina_dia[unidades_inspeccionadas] ) - SUM ( v_kpi_calidad_maquina_dia[unidades_retrabajo] ), SUM ( v_kpi_calidad_maquina_dia[unidades_inspeccionadas] ) )
		formatString: 0.00%
		displayFolder: 03 Calidad y energía
		lineageTag: 00baf92e-2841-4d63-bda9-37225fdbb3a8

	measure 'Tasa Defectos' =
			DIVIDE ( SUM ( v_kpi_calidad_maquina_dia[unidades_defectuosas] ), SUM ( v_kpi_calidad_maquina_dia[unidades_inspeccionadas] ) )
		formatString: 0.00%
		displayFolder: 03 Calidad y energía
		lineageTag: 719d8c21-f5be-4d14-97cb-09e3e64e3bee

	measure 'Tasa Retrabajo' =
			DIVIDE ( SUM ( v_kpi_calidad_maquina_dia[unidades_retrabajo] ), SUM ( v_kpi_calidad_maquina_dia[unidades_inspeccionadas] ) )
		formatString: 0.00%
		displayFolder: 03 Calidad y energía
		lineageTag: 8a9db81e-8a2d-4f26-aed3-2e650821b3a0

	measure 'Energía (kWh)' =
			SUM ( v_kpi_calidad_maquina_dia[energia_kwh] )
		formatString: #,##0.00
		displayFolder: 03 Calidad y energía
		lineageTag: f9b95be0-9e1f-4fb8-a209-ba3d8d490e9e

	measure 'Energía por Unidad Buena' =
			DIVIDE ( SUM ( v_kpi_calidad_maquina_dia[energia_kwh] ), SUM ( v_kpi_calidad_maquina_dia[good_count] ) )
		formatString: 0.0000
		displayFolder: 03 Calidad y energía
		lineageTag: e9c328dc-a5ac-4188-9bbb-0c8d43e5fa3a

	measure 'Scrap Rate (Calidad)' =
			DIVIDE ( SUM ( v_kpi_calidad_maquina_dia[scrap_count] ), SUM ( v_kpi_calidad_maquina_dia[total_count] ) )
		formatString: 0.00%
		displayFolder: 03 Calidad y energía
		lineageTag: b0af4efc-e4ac-424d-8bc4-ba8198d51490

