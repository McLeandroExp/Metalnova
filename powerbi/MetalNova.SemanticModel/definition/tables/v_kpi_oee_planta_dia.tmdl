table v_kpi_oee_planta_dia
	lineageTag: 84e3fc9d-29bb-4a49-9977-71b972621e05

	measure 'OEE KPI' =
			
			DIVIDE (
			    SUM ( v_kpi_oee_planta_dia[tiempo_operativo_min] ),
			    SUM ( v_kpi_oee_planta_dia[tiempo_planificado_min] )
			) *
			DIVIDE (
			    SUM ( v_kpi_oee_planta_dia[minutos_ideales] ),
			    SUM ( v_kpi_oee_planta_dia[tiempo_operativo_min] )
			) *
			DIVIDE (
			    SUM ( v_kpi_oee_planta_dia[good_count] ),
			    SUM ( v_kpi_oee_planta_dia[total_count] )
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 7fe86993-c795-4734-a1ba-4ce2316ff22c

