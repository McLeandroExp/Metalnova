		dataType: dateTime
		formatString: Long Date
		sourceProviderType: date
		lineageTag: 8a90aa3d-1d21-4bb3-8279-af0820659f5e
		summarizeBy: none
		sourceColumn: fecha

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

